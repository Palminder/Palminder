---
import { site } from '@/data/site';
import type { Experience } from '@/lib/content';
import { formatLongMonthYear, isoDate } from '@/lib/format';

interface Props {
  entry: Experience;
  headingLevel?: 'h2' | 'h3' | undefined;
}

const { entry, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const data = entry.data;
const isBreak = data.kind === 'career-break';
const hasDates = Boolean(data.startDate);
const hasBody = Astro.slots.has('default');
---

<article class:list={['experience-entry', { 'experience-entry--break': isBreak }]}>
  <Heading class="experience-entry__title"
    >{isBreak ? site.careerBreak.heading : data.organisation}</Heading
  >
  {!isBreak && data.role && <p class="experience-entry__role">{data.role}</p>}
  {
    !isBreak && hasDates && data.startDate && (
      <p class="experience-entry__dates mono">
        <time datetime={isoDate(data.startDate)}>{formatLongMonthYear(data.startDate)}</time>
        {' – '}
        {data.current ? (
          'present'
        ) : data.endDate ? (
          <time datetime={isoDate(data.endDate)}>{formatLongMonthYear(data.endDate)}</time>
        ) : (
          ''
        )}
        {data.location && <span> · {data.location}</span>}
      </p>
    )
  }
  {isBreak ? <p>{site.careerBreak.body}</p> : data.summary && <p>{data.summary}</p>}
  {
    data.responsibilities.length > 0 && (
      <ul class="experience-entry__list">
        {data.responsibilities.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  {
    data.technologies.length > 0 && (
      <ul class="tag-list" aria-label="Technologies">
        {data.technologies.map((item) => (
          <li>
            <span class="tag">{item}</span>
          </li>
        ))}
      </ul>
    )
  }
  {
    hasBody && (
      <div class="prose">
        <slot />
      </div>
    )
  }
</article>

<style>
  .experience-entry {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .experience-entry--break {
    border-left: 4px solid var(--color-border-strong);
  }

  .experience-entry__title {
    margin-bottom: var(--space-1);
  }

  .experience-entry__role {
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .experience-entry__dates {
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .experience-entry p:last-child,
  .experience-entry ul:last-child {
    margin-bottom: 0;
  }

  .experience-entry__list {
    padding-left: 1.2rem;
  }
</style>
