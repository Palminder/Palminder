---
import Badge from './Badge.astro';
import { credentialStatuses, credentialTypes } from '@/data/taxonomy';
import type { Credential } from '@/lib/content';
import { formatDate, isoDate } from '@/lib/format';

interface Props {
  credential: Credential;
  headingLevel?: 'h2' | 'h3' | undefined;
  /** Compact cards (home page) omit the description body. */
  compact?: boolean | undefined;
}

const { credential, headingLevel = 'h3', compact = false } = Astro.props;
const Heading = headingLevel;
const data = credential.data;
const statusLabel = credentialStatuses[data.status].label;
const inProgress = data.status === 'in-progress';
const hasBody = Astro.slots.has('default');
---

<article
  class:list={['card', 'credential-card', { 'credential-card--in-progress': inProgress }]}
  data-credential-status={data.status}
>
  <div class="card__meta">
    <Badge
      variant={data.status}
      label={inProgress ? 'IN PROGRESS — NOT YET EARNED' : statusLabel}
    />
    <span>{credentialTypes[data.credentialType]}</span>
  </div>
  <Heading>{data.title}</Heading>
  <dl class="facts">
    <dt>Issuer</dt>
    <dd>{data.issuer}</dd>
    {
      data.examCode && (
        <>
          <dt>Exam</dt>
          <dd>{data.examCode}</dd>
        </>
      )
    }
    <dt>Status</dt>
    <dd>{inProgress ? 'In progress — studying; not yet earned' : statusLabel}</dd>
    {
      data.earnedDate && (
        <>
          <dt>Earned</dt>
          <dd>
            <time datetime={isoDate(data.earnedDate)}>{formatDate(data.earnedDate)}</time>
          </dd>
        </>
      )
    }
    {
      data.renewalOrExpiryDate && (
        <>
          <dt>{data.status === 'earned-current' ? 'Renewal due' : 'Expired'}</dt>
          <dd>
            <time datetime={isoDate(data.renewalOrExpiryDate)}>
              {formatDate(data.renewalOrExpiryDate)}
            </time>
          </dd>
        </>
      )
    }
    {
      data.verificationUrl && (
        <>
          <dt>Verification</dt>
          <dd>
            <a href={data.verificationUrl} rel="noopener">
              Verify with {data.issuer}
            </a>
          </dd>
        </>
      )
    }
  </dl>
  {!compact && <p class="card__summary">{data.description}</p>}
  {
    !compact && hasBody && (
      <div class="prose credential-card__note">
        <slot />
      </div>
    )
  }
</article>

<style>
  .credential-card--in-progress {
    border-left: 4px solid var(--status-progress-border);
  }

  .credential-card__note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .credential-card__note :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
