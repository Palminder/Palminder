---
import { site } from '@/data/site';

const github = site.contact.github;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">{site.eyebrow}</p>
    <h1 id="hero-heading" class="hero__title">{site.headline}</h1>
    <p class="hero__capabilities">{site.capabilityLine}</p>
    <p class="hero__subheadline">{site.heroSubheadline}</p>

    <p class="hero__availability">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      <span>{site.availability}</span>
    </p>

    <p class="hero__status">
      <span class="badge badge--in-progress">{site.inProgressLabel}</span>
      <span>{site.currentDevelopment} <a href="/credentials/">Credential status</a></span>
    </p>

    <div class="hero__actions">
      <a class="button" href={site.cta.primary.href}>{site.cta.primary.label}</a>
      <a class="button button--secondary" href={site.cta.secondary.href}
        >{site.cta.secondary.label}</a
      >
      {
        github && (
          <a class="text-link" href={github} rel="me noopener">
            GitHub
          </a>
        )
      }
    </div>

    <p class="hero__experience">{site.experienceLine}</p>
  </div>
</section>

<style>
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem);
    max-width: calc(var(--max-width));
  }

  .hero__eyebrow {
    margin-bottom: var(--space-3);
  }

  .hero__title {
    font-size: var(--text-3xl);
    max-width: 22ch;
    margin-bottom: var(--space-2);
  }

  .hero__capabilities {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--color-accent-strong);
    margin-bottom: var(--space-4);
  }

  .hero__subheadline {
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 62ch;
    margin-bottom: var(--space-4);
  }

  .hero__availability {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .hero__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero__experience {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
