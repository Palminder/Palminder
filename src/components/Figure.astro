---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Evidence image with caption. Images are optimised by Astro, lazy-loaded, and link to the
 * full-size original as a normal link (no JavaScript lightbox).
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  decorative?: boolean | undefined;
  loading?: 'lazy' | 'eager' | undefined;
  sizes?: string | undefined;
}

const {
  image,
  alt,
  caption,
  decorative = false,
  loading = 'lazy',
  sizes = '(min-width: 56rem) 40rem, 100vw',
} = Astro.props;
const widths = [480, 800, 1200].filter((w) => w <= image.width);
if (widths.length === 0) widths.push(image.width);
---

<figure class="figure">
  <a
    class="figure__link"
    href={image.src}
    aria-label={decorative ? `Open full-size image: ${caption}` : `Open full-size image: ${alt}`}
  >
    <Image
      src={image}
      alt={decorative ? '' : alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  </a>
  <figcaption>{caption}</figcaption>
</figure>
