---
import PageLayout from '@/layouts/PageLayout.astro';
import LabFilters from '@/components/LabFilters.astro';
import LibraryListing from '@/components/LibraryListing.astro';
import { getLibraryItems, libraryFacets } from '@/lib/content';
import { paginate } from '@/lib/paginate';

const items = await getLibraryItems();
const facets = libraryFacets(items);
const page = paginate(items, 1, '/labs/');
---

<PageLayout
  title="Lab library"
  description="Searchable, filterable library of Palminder Dhariwal's labs and integrated case studies across endpoint management, identity, Microsoft 365, security, Azure, Windows Server and automation."
  eyebrow="Lab library"
  lede="Every published lab and integrated case study, labelled by evidence type and reviewed for currency. Search by keyword or filter by type, category, technology, target role and completion year."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Labs', href: '/labs/' },
  ]}
  currentNav="labs"
>
  <div class="container labs-controls">
    <LabFilters facets={facets} total={items.length} />
  </div>
  <LibraryListing page={page} facets={facets} heading="All evidence" />
</PageLayout>

<style>
  .labs-controls {
    padding-top: var(--space-6);
  }
</style>
