---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AutomationCard from '@/components/AutomationCard.astro';
import CapabilityMap from '@/components/CapabilityMap.astro';
import CredentialCard from '@/components/CredentialCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import EvidenceCard from '@/components/EvidenceCard.astro';
import EvidenceSnapshot from '@/components/EvidenceSnapshot.astro';
import Hero from '@/components/Hero.astro';
import { site } from '@/data/site';
import {
  getCapabilityEvidence,
  getEvidenceMetrics,
  getPublishedAutomationProjects,
  getPublishedCaseStudies,
  getPublishedCredentials,
  getPublishedExperience,
  getPublishedOrganisationProjects,
  sortFeaturedFirst,
  toLibraryItem,
} from '@/lib/content';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';

const metrics = await getEvidenceMetrics();

const featuredCaseStudies = sortFeaturedFirst(
  (await getPublishedCaseStudies()).map((entry) => toLibraryItem(entry, 'case-study')),
)
  .filter((item) => !item.archived)
  .slice(0, 3);

const capabilityEvidence = await getCapabilityEvidence();

const automation = (await getPublishedAutomationProjects())
  .filter((project) => !project.data.archived)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.lastReviewedDate.getTime() - a.data.lastReviewedDate.getTime(),
  )
  .slice(0, 2);

const employment = (await getPublishedExperience()).filter(
  (entry) => entry.data.kind === 'employment',
);

const credentials = await getPublishedCredentials();
const earned = credentials
  .filter((credential) => credential.data.status !== 'in-progress')
  .slice(0, 3);
const inProgress = credentials.filter((credential) => credential.data.status === 'in-progress');

const organisationProjects = sortFeaturedFirst(
  (await getPublishedOrganisationProjects()).map((entry) =>
    toLibraryItem(entry, 'organisation-project'),
  ),
)
  .filter((item) => !item.archived)
  .slice(0, 3);
---

<BaseLayout
  description={site.defaultDescription}
  currentNav="home"
  jsonLd={[websiteJsonLd(Astro.site), personJsonLd(Astro.site)]}
>
  <Hero />
  <EvidenceSnapshot metrics={metrics} />

  {
    featuredCaseStudies.length > 0 && (
      <section class="section" aria-labelledby="featured-heading">
        <div class="container">
          <div class="section-heading">
            <h2 id="featured-heading">Featured integrated case studies</h2>
            <a class="text-link" href="/evidence/case-studies/">
              All case studies
            </a>
            <p class="section-heading__lede">{site.evidenceIntro}</p>
          </div>
          <div class="grid grid--3">
            {featuredCaseStudies.map((item) => (
              <EvidenceCard item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    capabilityEvidence.length > 0 && (
      <section class="section" aria-labelledby="capability-heading">
        <div class="container">
          <div class="section-heading">
            <h2 id="capability-heading">Capability to evidence</h2>
            <p class="section-heading__lede">
              Each capability is backed by published work. Cards link directly to the labs, case
              studies and repositories that demonstrate it.
            </p>
          </div>
          <CapabilityMap entries={capabilityEvidence} />
        </div>
      </section>
    )
  }

  {
    automation.length > 0 && (
      <section class="section" aria-labelledby="automation-heading">
        <div class="container">
          <div class="section-heading">
            <h2 id="automation-heading">Automation and code</h2>
            <a class="text-link" href="/evidence/automation/">
              All repositories
            </a>
            <p class="section-heading__lede">
              Public, sanitised repositories with working code, safety controls and tests.
            </p>
          </div>
          <div class="grid grid--2">
            {automation.map((project) => (
              <AutomationCard project={project} compact />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="experience-heading">
    <div class="container">
      <div class="section-heading">
        <h2 id="experience-heading">Professional experience</h2>
        <a class="text-link" href="/experience/">Full experience</a>
      </div>
      <div class="grid grid--2 home-experience">
        <div class="stack">
          <p>{site.experienceLine}</p>
          <p class="muted">{site.backgroundLine}</p>
        </div>
        {
          employment.length > 0 && (
            <ul class="home-experience__list">
              {employment.map((entry) => (
                <li>
                  <strong>{entry.data.organisation}</strong>
                  {entry.data.role && <span class="muted"> — {entry.data.role}</span>}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="credentials-heading">
    <div class="container">
      <div class="section-heading">
        <h2 id="credentials-heading">Credentials and current development</h2>
        <a class="text-link" href="/credentials/">All credentials</a>
        <p class="section-heading__lede">
          Earned credentials and in-progress study carry distinct labels. Nothing is listed as
          earned unless it has been verified against an official transcript or badge.
        </p>
      </div>
      {
        earned.length > 0 && (
          <div class="home-credentials__group">
            <h3>Earned</h3>
            <div class="grid grid--3">
              {earned.map((credential) => (
                <CredentialCard credential={credential} compact />
              ))}
            </div>
          </div>
        )
      }
      {
        inProgress.length > 0 && (
          <div class="home-credentials__group">
            <h3>In progress</h3>
            <div class="grid grid--3">
              {inProgress.map((credential) => (
                <CredentialCard credential={credential} compact />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    organisationProjects.length > 0 && (
      <section class="section" aria-labelledby="organisation-heading">
        <div class="container">
          <div class="section-heading">
            <h2 id="organisation-heading">Authorised organisation projects</h2>
            <a class="text-link" href="/evidence/organisation-projects/">
              All organisation projects
            </a>
            <p class="section-heading__lede">
              Real work in genuine organisational environments, published only with written
              permission.
            </p>
          </div>
          <div class="grid grid--3">
            {organisationProjects.map((item) => (
              <EvidenceCard item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .home-experience__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .home-experience__list li {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .home-credentials__group + .home-credentials__group {
    margin-top: var(--space-5);
  }

  .home-credentials__group h3 {
    font-size: var(--text-md);
    color: var(--color-muted);
  }
</style>
