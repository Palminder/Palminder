---
import { render } from 'astro:content';
import EvidenceDetailLayout from '@/layouts/EvidenceDetailLayout.astro';
import { getPublishedCaseStudies, resolveRelated, toLibraryItem } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedCaseStudies();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const item = toLibraryItem(entry, 'case-study');
const related = await resolveRelated(entry.data.related);
---

<EvidenceDetailLayout
  item={item}
  entry={entry}
  related={related}
  currentNav="evidence"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Evidence', href: '/evidence/' },
    { label: 'Case studies', href: '/evidence/case-studies/' },
    { label: entry.data.title, href: item.url },
  ]}
>
  <Content />
</EvidenceDetailLayout>
