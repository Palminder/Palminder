---
import { render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CredentialCard from '@/components/CredentialCard.astro';
import { site } from '@/data/site';
import { getPublishedCredentials, type Credential } from '@/lib/content';

const credentials = await getPublishedCredentials();
const rendered = new Map(
  await Promise.all(
    credentials.map(
      async (credential) =>
        [
          credential.id,
          credential.body?.trim() ? (await render(credential)).Content : null,
        ] as const,
    ),
  ),
);

const groups: Array<{ id: string; title: string; lede: string; items: Credential[] }> = [
  {
    id: 'earned-current',
    title: 'Earned and current',
    lede: 'Verified against the official transcript or badge, with issuer verification links where available.',
    items: credentials.filter(
      (c) => c.data.status === 'earned-current' && c.data.credentialType !== 'applied-skill',
    ),
  },
  {
    id: 'earned-historical',
    title: 'Earned but historical or expired',
    lede: 'Credentials earned in the past that have since expired or been retired by the issuer.',
    items: credentials.filter(
      (c) => c.data.status === 'earned-expired' || c.data.status === 'historical',
    ),
  },
  {
    id: 'applied-skills',
    title: 'Microsoft Applied Skills',
    lede: 'Scenario-based practical assessments, listed only once earned and verifiable.',
    items: credentials.filter((c) => c.data.credentialType === 'applied-skill'),
  },
  {
    id: 'in-progress',
    title: 'In progress',
    lede: 'Current study. These have not been earned and are never presented as credentials held.',
    items: credentials.filter((c) => c.data.status === 'in-progress'),
  },
];
const visibleGroups = groups.filter((group) => group.items.length > 0);
---

<PageLayout
  title="Credentials"
  description="Credentials of Palminder Dhariwal with exact status: earned and current, historical, Microsoft Applied Skills, and in-progress study including Exam MD-102 toward Microsoft 365 Certified: Endpoint Administrator Associate."
  eyebrow="Credentials"
  lede="Status is exact and verification is easy. Nothing on this page is listed as earned unless it has been verified against an official transcript, badge or certificate."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Credentials', href: '/credentials/' },
  ]}
  currentNav="credentials"
>
  <div class="container credentials-status">
    <p class="notice notice--status">
      <span class="badge badge--in-progress">{site.inProgressLabel}</span>
      <span>{site.currentDevelopment}</span>
    </p>
  </div>

  {
    visibleGroups.map((group) => (
      <section class="section" aria-labelledby={`${group.id}-heading`}>
        <div class="container">
          <div class="section-heading">
            <h2 id={`${group.id}-heading`}>{group.title}</h2>
            <p class="section-heading__lede">{group.lede}</p>
          </div>
          <div class="grid grid--2">
            {group.items.map((credential) => {
              const Content = rendered.get(credential.id);
              return (
                <CredentialCard credential={credential}>{Content && <Content />}</CredentialCard>
              );
            })}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section" aria-labelledby="standard-heading">
    <div class="container">
      <div class="section-heading">
        <h2 id="standard-heading">How credentials are listed</h2>
      </div>
      <ul class="credentials-standard">
        <li>
          Each entry shows the issuer, exact title, status, dates and a verification link where one
          exists.
        </li>
        <li>
          In-progress study is labelled “in progress — not yet earned” everywhere it appears,
          including the home page.
        </li>
        <li>
          Planned or aspirational certifications are not published. Entries are added only from
          official verification data.
        </li>
        <li>
          Expired or retired credentials stay visible as historical facts with their original dates.
        </li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .credentials-status {
    padding-top: var(--space-6);
  }

  .credentials-status .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: 0;
  }

  .credentials-standard {
    max-width: var(--prose-width);
    padding-left: 1.2rem;
  }

  .credentials-standard li + li {
    margin-top: var(--space-2);
  }
</style>
