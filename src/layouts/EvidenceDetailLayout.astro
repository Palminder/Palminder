---
import PageLayout from './PageLayout.astro';
import Badge from '@/components/Badge.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import EvidenceCard from '@/components/EvidenceCard.astro';
import Figure from '@/components/Figure.astro';
import ProofIcons from '@/components/ProofIcons.astro';
import type { NavKey } from '@/components/SiteHeader.astro';
import { categoryLabel, evidenceTypes, targetRoleLabel, technologyLabel } from '@/data/taxonomy';
import {
  routes,
  type CaseStudy,
  type Lab,
  type LibraryItem,
  type OrganisationProject,
} from '@/lib/content';
import { formatDate, isoDate } from '@/lib/format';
import { creativeWorkJsonLd, type BreadcrumbItem } from '@/lib/seo';

/**
 * Detail template for labs, integrated case studies and organisation projects.
 *
 * Sections 1–3 and 17–19 of the content standard are generated from frontmatter; the Markdown
 * body supplies sections 4–16. The article carries Pagefind metadata so the lab library can
 * search, filter and sort it.
 */
interface Props {
  item: LibraryItem;
  entry: Lab | CaseStudy | OrganisationProject;
  breadcrumbs: BreadcrumbItem[];
  related: LibraryItem[];
  currentNav: NavKey;
}

const { item, entry, breadcrumbs, related, currentNav } = Astro.props;
const data = entry.data;
const evidenceType = evidenceTypes[item.evidenceType];
const series = 'series' in data ? data.series : undefined;
const proofLabels = [
  item.proof.code ? 'Code' : null,
  item.proof.diagram ? 'Diagram' : null,
  item.proof.tests ? 'Tests' : null,
].filter((label): label is string => Boolean(label));
const technologyLabels = item.technologies.map((key) => technologyLabel(key));
const rank = `${item.featured ? '1' : '0'}-${isoDate(item.lastReviewedDate)}`;
const description = data.seoDescription ?? item.summary;
const title = data.seoTitle ?? item.title;

const jsonLd = [
  creativeWorkJsonLd(
    {
      name: item.title,
      description: item.summary,
      path: item.url,
      dateCreated: item.completedDate,
      dateModified: item.lastReviewedDate,
      datePublished: item.publishedDate,
      keywords: [evidenceType.label, categoryLabel(item.category), ...technologyLabels],
      genre: evidenceType.label,
    },
    Astro.site,
  ),
];
---

<PageLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  currentNav={currentNav}
  noindex={item.archived}
  jsonLd={jsonLd}
  ogType="article"
  bare
>
  <article class="evidence-detail" data-pagefind-body>
    <header class="evidence-detail__header">
      <div class="container">
        <Breadcrumbs items={breadcrumbs} />
        <div class="cluster evidence-detail__labels">
          <span data-pagefind-filter="type"
            ><Badge variant={item.evidenceType} label={evidenceType.label} /></span
          >
          {item.archived && <Badge variant="archived" label="Archived evidence" />}
          <a
            class="evidence-detail__category"
            href={routes.category(item.category)}
            data-pagefind-filter="category"
            data-pagefind-meta="category"
          >
            {categoryLabel(item.category)}
          </a>
        </div>
        <h1>{item.title}</h1>
        {item.outcome && <p class="lede">{item.outcome}</p>}
        <p class="evidence-detail__context">
          <strong>{evidenceType.label}:</strong>
          {evidenceType.description}
        </p>
        {
          item.archived && (
            <p class="notice notice--status">
              <strong>Archived evidence — retained for historical context.</strong> The product or
              interface has changed since this work was completed and it has not been revalidated.
            </p>
          )
        }
        <span hidden data-pagefind-meta="summary">{item.summary}</span>
        <span hidden data-pagefind-meta={`category_url:${routes.category(item.category)}`}></span>
        <span hidden data-pagefind-meta={`completed:${isoDate(item.completedDate)}`}></span>
        <span hidden data-pagefind-meta={`reviewed:${isoDate(item.lastReviewedDate)}`}></span>
        <span hidden data-pagefind-meta="technologies">{technologyLabels.join(' | ')}</span>
        <span hidden data-pagefind-meta="proof">{proofLabels.join(' | ')}</span>
        <span hidden data-pagefind-meta={`archived:${item.archived ? 'true' : 'false'}`}></span>
        <span hidden data-pagefind-filter={`year:${item.year}`}></span>
        <span hidden data-pagefind-sort={`reviewed:${isoDate(item.lastReviewedDate)}`}></span>
        <span hidden data-pagefind-sort={`rank:${rank}`}></span>
      </div>
    </header>

    <div class="container evidence-detail__body">
      <section class="evidence-detail__snapshot" aria-labelledby="snapshot-heading">
        <h2 id="snapshot-heading">Snapshot</h2>
        <dl class="facts">
          <dt>Completed</dt>
          <dd>
            <time datetime={isoDate(item.completedDate)}>{formatDate(item.completedDate)}</time>
          </dd>
          <dt>Last reviewed</dt>
          <dd>
            <time datetime={isoDate(item.lastReviewedDate)}
              >{formatDate(item.lastReviewedDate)}</time
            >
          </dd>
          {
            data.platformVersion && (
              <>
                <dt>Platform version</dt>
                <dd>{data.platformVersion}</dd>
              </>
            )
          }
          <dt>Technologies</dt>
          <dd>
            <ul class="tag-list">
              {
                item.technologies.map((key) => (
                  <li>
                    <a class="tag" href={routes.technology(key)} data-pagefind-filter="technology">
                      {technologyLabel(key)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
          <dt>Role relevance</dt>
          <dd>
            <ul class="tag-list">
              {
                item.targetRoles.map((key) => (
                  <li>
                    <span class="tag" data-pagefind-filter="role">
                      {targetRoleLabel(key)}
                    </span>
                  </li>
                ))
              }
            </ul>
          </dd>
          {
            data.links.repository && (
              <>
                <dt>Repository</dt>
                <dd>
                  <a href={data.links.repository} rel="noopener">
                    {data.links.repository.replace(/^https?:\/\//, '')}
                  </a>
                </dd>
              </>
            )
          }
          {
            data.links.tests && (
              <>
                <dt>Test evidence</dt>
                <dd>
                  <a href={data.links.tests} rel="noopener">
                    {data.links.tests.replace(/^https?:\/\//, '')}
                  </a>
                </dd>
              </>
            )
          }
          {
            data.verificationLinks.length > 0 && (
              <>
                <dt>Verification</dt>
                <dd>
                  <ul class="evidence-detail__links">
                    {data.verificationLinks.map((link) => (
                      <li>
                        <a href={link.url} rel="noopener">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            proofLabels.length > 0 && (
              <>
                <dt>Evidence available</dt>
                <dd>
                  <ProofIcons proof={item.proof} repositoryUrl={item.repositoryUrl} />
                </dd>
              </>
            )
          }
        </dl>
      </section>

      <slot name="before-body" />

      {
        data.diagram && (
          <section class="evidence-detail__diagram" aria-labelledby="diagram-heading">
            <h2 id="diagram-heading">Architecture</h2>
            <Figure
              image={data.diagram.image}
              alt={data.diagram.alt}
              caption={data.diagram.caption}
              loading="eager"
            />
            <details class="evidence-detail__diagram-text">
              <summary>Text description of the diagram</summary>
              <p>{data.diagram.textAlternative}</p>
            </details>
          </section>
        )
      }

      {
        series && (
          <section class="evidence-detail__series" aria-labelledby="series-heading">
            <h2 id="series-heading">Series contents: {series.name}</h2>
            <ol class="evidence-detail__series-list">
              {series.parts.map((part) => (
                <li>
                  <strong>{part.title}</strong> — {part.summary}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <div class="prose">
        <slot />
      </div>

      {
        data.gallery.length > 0 && (
          <section class="evidence-detail__gallery" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading">Selected evidence</h2>
            <div class="gallery">
              {data.gallery.map((figure) => (
                <Figure
                  image={figure.image}
                  alt={figure.alt}
                  caption={figure.caption}
                  decorative={figure.decorative}
                />
              ))}
            </div>
          </section>
        )
      }

      {
        data.sanitisationStatement && (
          <section class="evidence-detail__sanitisation" aria-labelledby="sanitisation-heading">
            <h2 id="sanitisation-heading">Sanitisation and context</h2>
            <p>{data.sanitisationStatement}</p>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section
            class="evidence-detail__related"
            aria-labelledby="related-heading"
            data-pagefind-ignore
          >
            <h2 id="related-heading">Related labs and case studies</h2>
            <div class="grid grid--3">
              {related.map((relatedItem) => (
                <EvidenceCard item={relatedItem} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</PageLayout>

<style>
  .evidence-detail__header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-6) var(--space-5);
  }

  .evidence-detail__labels {
    margin-bottom: var(--space-3);
  }

  .evidence-detail__category {
    color: var(--color-muted);
  }

  .evidence-detail__header h1 {
    max-width: 28ch;
  }

  .evidence-detail__context {
    max-width: var(--prose-width);
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  .evidence-detail__header .notice {
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  .evidence-detail__body {
    padding-block: var(--space-6);
  }

  .evidence-detail__body > section {
    margin-bottom: var(--space-6);
  }

  .evidence-detail__snapshot {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    max-width: 52rem;
  }

  .evidence-detail__snapshot h2 {
    font-size: var(--text-md);
  }

  .evidence-detail__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .evidence-detail__diagram {
    max-width: 52rem;
  }

  .evidence-detail__diagram-text {
    margin-top: var(--space-3);
    max-width: var(--prose-width);
  }

  .evidence-detail__series-list {
    max-width: var(--prose-width);
    padding-left: 1.4rem;
  }

  .evidence-detail__series-list li + li {
    margin-top: var(--space-2);
  }

  .evidence-detail__sanitisation p {
    max-width: var(--prose-width);
    color: var(--color-muted);
  }

  .evidence-detail__related {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
</style>
