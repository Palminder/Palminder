---
import '@/styles/global.css';
import '@/styles/shiki.css';
import SiteHeader, { type NavKey } from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';
import { siteEnv } from '@/lib/env';
import { absoluteUrl, pageTitle } from '@/lib/seo';

interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string | undefined;
  description: string;
  /** Force noindex regardless of environment (archived evidence, utility pages). */
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
  jsonLd?: Array<Record<string, unknown>> | undefined;
  currentNav?: NavKey | undefined;
  bodyClass?: string | undefined;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  jsonLd = [],
  currentNav,
  bodyClass,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const robots = siteEnv === 'production' && !noindex ? 'index, follow' : 'noindex, nofollow';
const ogImage = absoluteUrl('/og-default.png', Astro.site);
const serialise = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b5cad" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={serialise(data)} />
      ))
    }
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader current={currentNav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100%;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-accent);
    color: #ffffff;
    border-radius: 0 0 var(--radius) var(--radius);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 0;
  }

  main:focus {
    outline: none;
  }
</style>
