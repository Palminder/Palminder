# Copy to `.env` for local overrides. Never commit `.env`.
#
# PUBLIC_SITE_ENV controls indexing metadata and robots.txt:
#   preview     -> <meta name="robots" content="noindex, nofollow"> and robots.txt disallows all (default)
#   production  -> indexable, robots.txt allows crawling and lists the sitemap
PUBLIC_SITE_ENV=preview

# Canonical origin of the deployed site. Required for production builds.
# Preview builds fall back to Cloudflare's CF_PAGES_URL, then http://localhost:4321.
# PUBLIC_SITE_URL=https://example.pages.dev
