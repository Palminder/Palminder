# Bracken & Roe website — environment variables
# Copy to .env.local for development. Never commit real values.
# Production and preview values live only in the hosting provider's environment settings.

# ---- Site -------------------------------------------------------------------
# Canonical origin. Production: https://brackenroe.co.uk (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publication stage for the content layer. Defaults to "production", which enforces
# the verification gates on CMS records. "staging" is an editorial review mode that
# also renders held CMS records so layouts can be checked before verification.
# CONTENT_STAGE=production

# ---- Sanity -----------------------------------------------------------------
# When SANITY_PROJECT_ID and SANITY_DATASET are unset the site renders the local
# seed content from src/content/seed (the same publication gates still apply).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01
# Server only. Needed for draft-mode preview of unpublished content.
SANITY_READ_TOKEN=
# Shared secret for the /api/revalidate webhook (Sanity webhook signature secret).
SANITY_REVALIDATE_SECRET=
# Secret required to enable draft mode via /api/draft?secret=...
SANITY_PREVIEW_SECRET=

# ---- Enquiry form -----------------------------------------------------------
# Server only.
RESEND_API_KEY=
# Verified sending identity on a domain/subdomain configured for Resend.
ENQUIRY_FROM_EMAIL=website@brackenroe.co.uk
ENQUIRY_TO_EMAIL=studio@brackenroe.co.uk
# Send a plain acknowledgement email to the enquirer (true/false).
ENQUIRY_SEND_ACKNOWLEDGEMENT=false

# Cloudflare Turnstile. The site key is public; the secret is server only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# File uploads are disabled unless BOTH values are set: an explicit opt-in and a
# malware-scanning endpoint (clamav-rest compatible: POST multipart "file" -> JSON).
ENQUIRY_UPLOADS_ENABLED=false
MALWARE_SCAN_ENDPOINT=

# Rate limiting. Without an Upstash Redis REST endpoint an in-memory limiter is used
# (per server instance — adequate for preview, not for multi-instance production).
RATE_LIMIT_UPSTASH_REDIS_REST_URL=
RATE_LIMIT_UPSTASH_REDIS_REST_TOKEN=
# Optional overrides (defaults: 5 per 15 minutes, 20 per day).
# RATE_LIMIT_WINDOW_MAX=5
# RATE_LIMIT_DAY_MAX=20

# ---- Social (hidden entirely until set) ------------------------------------
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=

# ---- Analytics --------------------------------------------------------------
# Absent by default. No analytics ships until the practice chooses a product and
# completes its privacy configuration.
